<?xml version="1.0" encoding="UTF-8"?>

<!ELEMENT mozi (film)*>

<!ELEMENT film (rendezo*,szinesz*,iro*)>
<!ATTLIST film id ID #REQUIRED>
<!ATTLIST film mufaj (horror | romantikus | thriller) "horror">

<!ELEMENT rendezo (iroda+,phone+)>
<!ATTLIST rendezo id ID #REQUIRED>
<!ATTLIST rendezo nev CDATA #IMPLIED>

<!ELEMENT szinesz (gyerekszinesz?,musicalszinesz?,szinkronszinesz?)>
<!ATTLIST szinesz id ID #REQUIRED>
<!ATTLIST szinesz nev CDATA #IMPLIED>

<!ELEMENT iro (iroda+,phone+)>
<!ATTLIST iro id ID #REQUIRED>